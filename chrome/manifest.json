{
    "name": "MatTalX - LaTeX to Unicode math symbols",
    "description": "Type LaTeX in any text field and press Alt+Shift+W to get Unicode math: \\alpha becomes 𝛼. No popup, no copy-paste.",
    "version": "3.0.0",
    "icons": {
        "32": "/images/mattalx_favicon32.png",
        "48": "/images/mattalx_favicon48.png",
        "128": "/images/mattalx_favicon128-nobg.png"
    },
    "manifest_version": 3,
    "background": {
        "service_worker": "background.js",
        "type": "module"
    },
    "commands": {
        "_execute_action": {
            "suggested_key": {
                "default": "Alt+Shift+M"
            }
        },
        "convert_inline": {
            "suggested_key": {
                "default": "Alt+Shift+W"
            },
            "description": "Convert what is written in the page"
        },
        "complete_inline": {
            "suggested_key": {
                "default": "Alt+Shift+C"
            },
            "description": "Suggest commands while writing in the page"
        }
    },
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "32": "/images/mattalx_favicon32.png",
            "48": "/images/mattalx_favicon48.png",
            "128": "/images/mattalx_favicon128-nobg.png"
        },
        "default_title": "MatTalX - LaTeX to Unicode math symbols"
    },
    "permissions": [
        "storage",
        "activeTab",
        "scripting"
    ]
}
