{
    "name": "MatTalX - Write math symbols",
    "description": "Write mathematical expressions anywhere - Convert LaTeX commands to plain text and paste it on any platform!",
    "version": "2.7.5",
    "icons": {
        "48": "/images/mattalx_favicon48.png",
        "96": "/images/mattalx_favicon96.png"
    },
    "manifest_version": 2,
    "background": {
        "page": "background.html",
        "persistent": false
    },
    "browser_specific_settings": {
        "gecko": {
            "id": "mattalx@samuel.ca"
        }
    },
    "commands": {
        "_execute_browser_action": {
            "suggested_key": {
                "default": "Alt+Shift+M"
            }
        },
        "convert_inline": {
            "suggested_key": {
                "default": "Alt+Shift+W"
            },
            "description": "Convert what is written in the page"
        },
        "complete_inline": {
            "suggested_key": {
                "default": "Alt+Shift+C"
            },
            "description": "Suggest commands while writing in the page"
        }
    },
    "browser_action": {
        "default_popup": "popup.html",
        "default_icon": {
            "48": "/images/mattalx_favicon48.png",
            "96": "/images/mattalx_favicon96.png"
        },
        "default_title": "MatTalX - Write math symbols"
    },
    "permissions": [
        "storage",
        "activeTab"
    ]
}
